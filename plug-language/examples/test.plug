# Minimal mock smoke script used by the README.
# Run with: java -jar target/plug.jar run examples/test.plug

plug.connect(
    host: "localhost",
    port: 5432,
    database: "mydb",
    username: "victor",
    password: "secret"
);

plug.use("users");

plug.get(name, country, balance)
    .where(
        (balance, GT, 10000)
        AND
        (country, NE, "Nigeria")
    )
    .limit(2);
