<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.victor</groupId>
    <artifactId>plug</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <junit.version>5.10.2</junit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            PostgreSQL JDBC driver: the transport dependency of
            the postgres adapter. Compile scope, because the
            adapter registers itself in the driver registry and
            users selecting driver "postgres" expect it on
            the classpath out of the box.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>
    </dependencies>

    <build>
        <!--
            Name the packaged artifact plug.jar: the runnable,
            dependency-bundled executable produced in package.
        -->
        <finalName>plug</finalName>
        <!--
            Filter src/main/resources so version.properties picks
            up the pom's <version>; the CLI reports this value
            (the version command), keeping CLI/language/build
            versions consistent from one source.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!--
                Compiled with release 17: bytecode targets Java 17
                (class file version 61) and the API surface is
                checked against the documented Java 17 methods, so
                the packaged jar runs on any Java 17+ install.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!--
                Distribution packaging: the main artifact itself
                (plug.jar, via finalName) becomes the runnable
                dependency-bundled executable with Main-Class =
                dev.victor.plug.cli.CliMain, so
                "java -jar plug.jar run s.plug" works without a
                local classpath. The PostgreSQL JDBC driver ships
                inside it automatically — it is a compile-scope
                dependency of the postgres adapter — and the
                services transformer keeps its
                META-INF/services/java.sql.Driver entry intact so
                DriverManager can discover it at runtime.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.victor.plug.cli.CliMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>